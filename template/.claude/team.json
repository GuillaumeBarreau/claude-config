{
  "$comment": "Configuration de l'équipe d'agents pour ce projet. Appartient au projet : install.mjs la crée une fois et ne la remplace jamais. À compléter avec /team-init.",
  "version": 1,
  "initialized": false,
  "baseBranch": "main",
  "branchPrefix": "team/",
  "commitConvention": "",
  "autonomy": "supervised",
  "maxAttempts": 2,
  "maxClarificationRounds": 2,
  "agents": {
    "planner": true,
    "implementer": true,
    "implementer-backend": true,
    "implementer-frontend": true,
    "documentation": true,
    "code-reviewer": true,
    "expert": true
  },
  "pullRequest": {
    "draft": true,
    "titlePattern": "",
    "maxChangedLines": 400,
    "labels": []
  },
  "sensitivePaths": [],
  "escalationModel": "opus",
  "ci": {
    "enabled": true,
    "timeoutMinutes": 30,
    "maxFixRounds": 2
  },
  "prComments": {
    "allowedAssociations": [
      "OWNER",
      "MEMBER",
      "COLLABORATOR"
    ]
  },
  "lessons": {
    "enabled": true,
    "maxEntries": 30
  },
  "backlog": {
    "label": "agent-ready",
    "draftPr": false,
    "maxIssues": 3,
    "maxBudgetUsd": 5
  },
  "parallel": {
    "enabled": false
  },
  "checks": []
}
