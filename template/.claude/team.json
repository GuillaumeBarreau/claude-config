{
  "$comment": "Configuration de l'équipe d'agents pour ce projet. Appartient au projet : install.mjs la crée une fois et ne la remplace jamais. À compléter avec /team-init.",
  "version": 1,
  "initialized": false,
  "baseBranch": "main",
  "branchPrefix": "team/",
  "commitConvention": "",
  "autonomy": "supervised",
  "maxAttempts": 2,
  "maxClarificationRounds": 2,
  "agents": {
    "cc-planner": true,
    "cc-implementer": true,
    "cc-implementer-backend": true,
    "cc-implementer-frontend": true,
    "cc-documentation": true,
    "cc-code-reviewer": true,
    "cc-expert": true,
    "cc-analyste": true,
    "cc-pr-reviewer-frontend": true,
    "cc-pr-reviewer-backend": true,
    "cc-pr-reviewer-architecture": true,
    "cc-pr-verifier": true
  },
  "pullRequest": {
    "draft": true,
    "titlePattern": "",
    "maxChangedLines": 400,
    "labels": []
  },
  "sensitivePaths": [],
  "escalationModel": "opus",
  "ci": {
    "enabled": true,
    "timeoutMinutes": 30,
    "maxFixRounds": 2
  },
  "prComments": {
    "allowedAssociations": [
      "OWNER",
      "MEMBER",
      "COLLABORATOR"
    ]
  },
  "lessons": {
    "enabled": true,
    "maxEntries": 30
  },
  "backlog": {
    "label": "agent-ready",
    "draftPr": false,
    "maxIssues": 3,
    "maxBudgetUsd": 5
  },
  "parallel": {
    "enabled": false
  },
  "review": {
    "language": "fr",
    "event": "COMMENT",
    "maxInlineCould": 5,
    "architectureMinLines": 150,
    "axes": {
      "frontend": [],
      "backend": []
    },
    "batch": {
      "maxPrs": 3
    }
  },
  "checks": []
}
