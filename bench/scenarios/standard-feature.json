{
  "description": "Petite fonctionnalité : piste standard, plan validé en autonomie, un commit par tâche, relectures enregistrées.",
  "request": "Ajouter une option --json à la commande list de src/cli.js : elle affiche les titres d'exemple et leurs identifiants sous forme de tableau JSON.",
  "expect": {
    "status": "awaiting_delivery_approval",
    "track": "standard",
    "tasks": { "min": 1, "max": 3, "allStatus": "done" },
    "requiresHuman": false,
    "checks": { "tests": "passed" },
    "gates": { "plan": "passed", "checks": "passed", "review": "passed", "delivery": "pending" },
    "git": {
      "baseUnchanged": true,
      "pushed": false,
      "commitsOnBranch": { "min": 1, "max": 3 },
      "commitPerTask": true,
      "changedFiles": {
        "include": ["src/cli.js", "test/**"],
        "exclude": ["package.json", ".claude/**"]
      }
    },
    "files": ["review-*.json"],
    "checkState": true,
    "maxCostUsd": 3
  }
}
